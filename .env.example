# ─── Frisk Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in real values before starting.

# API key that merchants / your frontend must send in X-API-Key header
FRISK_API_KEY=frisk-demo-key-2024

# Groq API key for the Chargeback Evidence Responder (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ML service base URL (used by the Express gateway)
ML_SERVICE_URL=http://ml-service:8000

# Optional: merchant webhook endpoint (POST flagged results here)
WEBHOOK_URL=

# Node / frontend
NODE_ENV=development
VITE_API_URL=http://localhost:4000
